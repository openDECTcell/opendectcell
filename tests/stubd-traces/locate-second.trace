# Two stored handsets; the second locates on the main link, so MM adopts
# its held record and it becomes the current one (S2.3c). Identities and
# keys are made up.
sub 1 80 a8 03 11 22 33 44
sub 2 80 a8 03 55 66 77 88
start
ev hello api=N lines=1 hs=2
ev hs hs=1 state=registered name="DECT 1" wideband=1
ev hs hs=2 state=registered name="DECT 2" wideband=1
mail 0153 00
mail 0169 07
mail 0157 00
mail 015b 01
mail 022c 01
mail 0247 03 00 00
mail 0247 04 00 00
mail 0247 05 00 00
mail 0247 06 00 00
mail 0247 02 01 00
mail 020a 02 c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 ca cb cc cd ce cf 00
mail 0247 01 01 00
mail 020a 01 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 ba bb bc bd be bf 00
mail 017c 00 03

up 1
# {LOCATE-REQUEST} from DECT 2
pp 05 54 05 07 80 a8 03 55 66 77 88 06 07 a0 a5 00 01 23 45 60
fp 05 40 0a 03 01 18 08 0c 08 eb 10 35 5a 7f a4 c9 ee 0e 08 13 38 5d 82 a7 cc f1 16
tick 200
mail fff1 07 18 95 00 00 11 00
mail fff1 07 29 95 00 00 11 00
mail fff1 07 3a 95 00 00 11 00
mail fff1 07 4b 95 00 00 11 00
mail fff1 07 5c 95 00 00 11 00
mail fff1 07 6d 95 00 00 11 00
mail fff1 07 18 95 00 00 11 00
# DECT 2 authenticates with its own UAK (c0..cf)
pp 85 41 0d 04 7f b3 da 74
fp 85 55 05 05 a0 94 00 11 02 07 01 64 7c 07 90 03 00 01 02 00 84
fp 64 62 23 08 c0 26 10 30 09 00 00 00
tick 500
mail fff1 07 18 95 00 00 11 00
down
tick 1000
