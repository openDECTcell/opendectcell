# openDECTcell board profile: AVM FRITZ!Box 7362 SL (Lantiq VR9, VR9 TDM).
# Installed as /usr/share/opendectcell/boards/avm,fritz7362sl.
# Read by /etc/init.d/opendectcell; UCI options in /etc/config/opendectcell override.
# Keys: see docs/hardware-abstraction.md section 4.
#
# The firmware-load UART is kmod-lantiq-usif-uart [CR 7362SL/A-0002, A-0003],
# the PCM link kmod-lantiq-tdm-pcm [CR 7362SL/A-0004, A-0005]
# (docs/models/7362SL-DECT-analysis.md section 7). Gate G2 (the control
# channel over the TDM transport) is untested.

name="FRITZ!Box 7362 SL"
transport=lantiq-tdm

fw_family=441
# The 7362 SL's own 07.18 build. Its first stage is the 7412's file,
# byte for byte, so it keeps the 7412's name.
fw_firstlevel=dectfw_firstlevel_441-06.88-7412.hex
fw_secondlevel=dectfw_secondlevel_441-07.18-7362sl.hex
fw_firstlevel_sha256=72f8e27a0d01c301a05a8b373a71887af882a6cebcb1a30bd4a435580e1045f2
fw_secondlevel_sha256=8aae3b5e3450fd2c9999e003068e786096c11d8ef53f7d47c25cebd057a797d3

# Stock mode word (derived statically, FRITZ!OS 07.18): 8 slots of 16 bit
# per frame on this box [CR 7362SL/A-0004].
dect_mode=0x101

# The PCM bus: the VR9 TDM transport (kmod-lantiq-tdm-pcm), the same uapi
# as the 7412's SSC transport. The hardware aligns its frames to FSC, so
# there is no bit offset to find; a lost frame is lost whole, and the
# transmitter repeats its last frame [CR 7362SL/A-0004]. Loaded before the
# chip boots, as on the 7412.
pcm_kmod=lantiq_tdm_pcm
pcm_dev=/dev/tdm-pcm0
pcm_slots=8

# The DECT UART is the VR9 USIF on GPIO11/12, not the console:
# kmod-lantiq-usif-uart's /dev/ttyUSIF0, loaded by the service before the
# upload (tested on a 7362 SL in loopback, 9600 to 460800 Bd).
uart=/dev/ttyUSIF0
uart_kmod=lantiq_usif_uart
uart_is_console=0

# The boot strap is the chip's TX line (GPIO 11, the USIF's RX pin): the ROM
# answers only if it is held low while reset is released, as on the 7520
# (observed 2026-11-01, docs/bench-7362sl.md). The openDECTcell module drives it
# and hands the pin back to the USIF afterwards.
strap=1

# The chip's reset line, as the openDECTcell module claims it (GPIO30; low holds
# the chip in reset, as in the stock board table [CR 7362SL/A-0001]).
reset_chip=gpio-xway
reset_line=30

# The DECT LED (OpenWrt 7362 SL device tree: green, function "dect", GPIO35).
led_path=/sys/class/leds/green:dect/brightness

# Factory DECT config block: urlader partition on the SPI NOR (mtd2), header
# 02 01 at 0x1985 (observed on one box, 2026-11-01).
factory_cfg=
factory_mtd=/dev/mtd2
factory_offset=0x1985
rfpi_fallback=maca

# Three on the 7520 and 7412; not measured for this build or mode.
max_calls=3
