# A stored handset dials overlap (digits in {CC-INFO}) and no bridge is
# connected: after the dial pause the base connects the call itself,
# through the routed steps alertms= and bindfirst (PROCEEDING and
# ALERTING, the audio bound, CONNECT once 0x022D is sent and the alert
# time is over). -C: no ciphering, so the number goes on without the key
# proof. Identities, keys and numbers are made up.
sub 1 80 a8 03 11 22 33 44
args -C -a alertms=1000,bindfirst,dialwait=2000
start
ev hello api=N lines=1 hs=1
ev hs hs=1 state=registered name="DECT 1" wideband=1
mail 0153 00
mail 0169 07
mail 0157 00
mail 015b 01
mail 022c 01
mail 0247 02 00 00
mail 0247 03 00 00
mail 0247 04 00 00
mail 0247 05 00 00
mail 0247 06 00 00
mail fff1 07 18 95 00 00 11 00
mail fff1 07 29 95 00 00 11 00
mail fff1 07 3a 95 00 00 11 00
mail fff1 07 4b 95 00 00 11 00
mail fff1 07 5c 95 00 00 11 00
mail fff1 07 6d 95 00 00 11 00
mail 0247 01 01 00
mail 020a 01 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 ba bb bc bd be bf 00
mail fff1 07 18 95 00 00 11 00
mail 017c 00 01

up 1
# {CC-SETUP}: <<PORTABLE-IDENTITY>>, <<FIXED-IDENTITY>> (PARK),
# <<BASIC-SERVICE>> normal call, basic speech; no number yet.
pp 03 05 05 07 80 a8 03 11 22 33 44 06 07 a0 a5 00 01 23 45 60 e0 80
fp 83 0d 7e 06 01 00 81 02 01 82
tick 200
# {CC-INFO} <<MULTI-KEYPAD>> "030", then "12" a second later.
pp 03 7b 2c 03 30 33 30
tick 1000
pp 03 7b 2c 02 31 32
tick 1500
# Quiet for 2000 ms: the number is complete.
tick 1000
fp 83 02 7e 06 01 00 81 02 01 83
fp 83 01 7e 06 01 00 81 02 01 84
mail 0251 01 01 2b
mail 0230 01 01 00 00 00 00
mail 022d 01 00
tick 1000
fp 83 07 7e 06 01 00 81 02 01 85
tick 1000
# The handset hangs up: {CC-RELEASE}, <<RELEASE-REASON>> normal.
pp 03 4d e2 00
fp 83 5a
mail 0233 01 01
mail 0202 01
tick 500
down
tick 1000
