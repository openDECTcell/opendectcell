# openDECTcell board profile: AVM FRITZ!Box 7412 (Lantiq VR9, SSC "SPI-TDM").
# Installed as /usr/share/opendectcell/boards/avm,fritz7412.
# Read by /etc/init.d/opendectcell; UCI options in /etc/config/opendectcell override.
# Keys: see docs/hardware-abstraction.md section 4.

name="FRITZ!Box 7412"
transport=lantiq-ssc

fw_family=441
fw_firstlevel=dectfw_firstlevel_441.hex
fw_secondlevel=dectfw_secondlevel_441.hex
fw_firstlevel_sha256=72f8e27a0d01c301a05a8b373a71887af882a6cebcb1a30bd4a435580e1045f2
fw_secondlevel_sha256=4fabee65d07a3214f9083de81ae54089f01bbfccb4cdbb672f37487a09cdfaa6

# Low byte of the mode word goes into TLV tag 7; bit 8 is the first-level
# boot flag (see docs/7412-spi-tdm-and-loader.md section 2).
dect_mode=0x119

# The DECT UART is the SoC console UART on this box.
uart=/dev/ttyLTQ0
uart_is_console=1

# The stock DTB names a "rd" line on GPIO8 (the DECT reset line, module PIGLET),
# but driving it (either polarity) makes the chip fail to boot, so it is not
# used as a strap: the uploader must not touch it.
strap=0

# The DECT LED (OpenWrt 7412 device tree: green:dect on GPIO15).
led_path=/sys/class/leds/green:dect/brightness

# Factory DECT config block and RFPI fallback: still open (M1).
factory_cfg=
factory_mtd=
rfpi_fallback=maca

max_calls=3
