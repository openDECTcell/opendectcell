#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
#
# The box's board profile (docs/hardware-abstraction.md); UCI overrides it.
b=$(cat /tmp/sysinfo/board_name 2>/dev/null)
[ -n "$b" ] && [ -r "/usr/share/opendectcell/boards/$b" ] &&
	. "/usr/share/opendectcell/boards/$b"

# Until 0.3.1 the default config named the 7520's chip settings, and UCI
# overrides the profile, so every other box ran with the 7520's UART,
# factory block, firmware and mode. Drop them where they still hold those
# defaults on a box that is not a 7520/7530.
if [ -n "$b" ] && [ "$b" != avm,fritzbox-7530 ]; then
	for kv in first=dectfw_firstlevel_441_slow.hex \
		  second=dectfw_secondlevel_441-07.56.hex \
		  uart=/dev/ttyMSM0 factory_mtd=/dev/mtd5 \
		  factory_offset=0x3d000 mode=0x105; do
		[ "$(uci -q get "opendectcell.main.${kv%%=*}")" = "${kv#*=}" ] &&
			uci -q delete "opendectcell.main.${kv%%=*}"
	done
	uci -q commit opendectcell
fi

# The FRITZ!Box 7520/7530 and 7412 have one usable UART, and it belongs to
# the DECT chip: the firmware upload and the chip's boot replies run over
# it. A login getty on it reads those bytes away. Disable it (from the next
# boot on); /etc/init.d/opendectcell freezes a running one until then. Kept as
# /etc/inittab.opendectcell-orig.

u=$(uci -q get opendectcell.main.uart)
uart=${u:-${uart:-/dev/ttyMSM0}}
tty=${uart##*/}
if grep -q "^$tty::" /etc/inittab 2>/dev/null; then
	[ -e /etc/inittab.opendectcell-orig ] || cp /etc/inittab /etc/inittab.opendectcell-orig
	sed -i "s|^$tty::|#$tty::|" /etc/inittab
	logger -t opendectcell "disabled the console getty on $tty, the DECT UART"
fi
# Until 0.3.1 the default config carried the service's own dect-stubd
# options in 'options'; the service passes them itself now. Clear them
# where they still hold that default, so Extra options shows only the
# user's.
[ "$(uci -q get opendectcell.main.options)" = mask=0x0002,codec=3,status=8000 ] &&
	uci -q set opendectcell.main.options='' && uci -q commit opendectcell

# A random registration PIN unless one is set: pin_length digits, 8 unless
# chosen otherwise (Network > DECT, Handsets).
if [ -z "$(uci -q get opendectcell.main.pin)" ]; then
	n=$(uci -q get opendectcell.main.pin_length)
	case "$n" in 4|6|8) ;; *) n=8 ;; esac
	uci -q set opendectcell.main.pin="$(tr -dc 0-9 < /dev/urandom | head -c "$n")"
	uci -q commit opendectcell
fi
exit 0
