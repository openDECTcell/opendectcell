# openDECTcell: DECT base station. Nothing runs until enabled is '1'.
config opendectcell 'main'
	option enabled '0'
	# AVM's chip firmware, supplied by you (never shipped): the two
	# Intel-HEX stages from a FRITZ!OS image for this box.
	option firmware_dir '/etc/opendectcell/firmware'
	# Run a firmware build openDECTcell does not know (developers only).
	option fw_allow_unverified '0'
	# The box's own chip settings -- the two firmware files, the DECT
	# UART, the factory DECT block (RFPI and calibration) and the mode
	# word -- come from its board profile in /usr/share/opendectcell/boards/.
	# Set them here only to override it, e.g. on a FRITZ!Box 7520/7530:
	#option first 'dectfw_firstlevel_441_slow.hex'
	#option second 'dectfw_secondlevel_441-07.56.hex'
	#option uart '/dev/ttyMSM0'
	#option factory_mtd '/dev/mtd5'
	#option factory_offset '0x3d000'
	#option mode '0x105'
	# What the box is: 'base' (its own DECT base, the default) or 'cell'
	# of an openDECTcell controller (package opendectcell-cell; /etc/init.d/opendectcell
	# enroll sets it).
	#option role 'base'
	# In cell mode, '1' lets the controller send a call's speech as plain
	# RTP instead of SRTP: unencrypted, for a network you trust end to end.
	#option cell_plain_rtp '0'
	# Registration PIN (AC): pin_length digits, 8, 6 or 4 (Network >
	# DECT takes no other length). Empty: a random one is made at install
	# and shown on Network > DECT, Handsets, so nobody nearby can enrol
	# with 0000 while the window is open.
	option pin ''
	option pin_length '8'
	# '1' opens registration while the service runs; '0' keeps it
	# closed, and handsets already subscribed attach as usual. To enrol a
	# handset, prefer `/etc/init.d/opendectcell register` (or the button on
	# Network > DECT, Handsets): it opens registration for regwindow seconds and
	# closes it again after one handset enrolled.
	option registration '0'
	option regwindow '120'
	# Where the base keeps its handsets: one file per registered handset.
	option stores '/etc/opendectcell-sub.*'
	# Wideband (G.722, "HD") when the handset offers it; '0' keeps every
	# call narrowband (G.726).
	option wideband '1'
	# Collect a handset's dialled digits before connecting (SETUP-ACK,
	# digits, CONNECT): the number is complete dialwait ms after the
	# last digit. '0' connects at once and the digits follow the call.
	option overlap '1'
	option dialwait '3000'
	# Cipher calls (DECT standard cipher, DSC); '0' leaves the radio link
	# in the clear, for audio debugging only.
	option cipher '1'
	# Authenticate a handset with its key whenever it reports in
	# (location registration); a handset that cannot is turned away.
	option locauth '1'
	# Up to three calls at once (the DECT chip's audio channels): other
	# handsets may call, be called and call each other while one is in
	# a call. '0': one call at a time. (The name is historical: it once
	# allowed two.)
	option twocalls '1'
	# Hours between sending the date and time to every handset; each
	# one also gets it whenever it reports in. '0': only then.
	option time_update '24'
	# SIP (package opendectcell-baresip): an INVITE is taken only from the
	# address an account registers with; '1' takes it from anywhere, for
	# a provider that calls from other servers.
	#option sip_any_source '0'
	# Further dect-stubd -a options, comma-separated, for developers
	# (Network > DECT, Advanced: Extra options). The service always
	# passes its own first (the audio bind and the radio figures of
	# Status > DECT); a key set here again wins.
	option options ''

# The handsets' phonebook from CardDAV address books, both ways: an edit or
# delete on a handset goes back to the book the contact came from, a new
# contact to 'default' (package opendectcell-carddav; LuCI: Network > DECT,
# Phonebook, which also finds the books). url: any address of the account,
# https:// only; with no 'book' listed, url is the one book. Contacts are
# not merged across books. ca_file: a PEM CA for a self-hosted server
# (default: the system bundle). allow_clear '1' lets a handset's "delete
# list" empty every book used here.
#config carddav 'carddav'
#	option enabled '0'
#	option url 'https://cloud.example.org'
#	option username ''
#	option password ''
#	list book 'https://cloud.example.org/remote.php/dav/addressbooks/users/NAME/contacts/'
#	option default 'https://cloud.example.org/remote.php/dav/addressbooks/users/NAME/contacts/'
#	option interval '15'
#	option allow_clear '0'
