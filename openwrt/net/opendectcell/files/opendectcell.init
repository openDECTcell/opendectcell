#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
#
# openDECTcell: boot the DECT chip and run the base station daemon.
#
# Disabled by default (option enabled '0'): installing the package loads no
# module and puts nothing on the air. Stopping the service parks the radio:
# dect-stubd parks it on SIGTERM and reads the park back from the chip;
# a park it could not confirm puts the chip in reset (park_guard).

START=95
STOP=10
USE_PROCD=1
extra_command "register" "Open handset registration for 'regwindow' seconds (120)"
extra_command "forget" "Remove a deregistered handset's settings: forget <1-6>"
extra_command "enroll" "Make this box a cell of an openDECTcell controller: enroll '<enrollment string>' or enroll @<file with it>"
extra_command "cell_leave" "Leave cell mode: erase the cell's credentials and run the base again"

PROG=/usr/sbin/dect-stubd
CELL=/usr/sbin/dect-cell
CARDDAV=/usr/share/opendectcell/carddav.uc

log() { logger -t opendectcell "$*"; echo "opendectcell: $*" >&2; }

# Model-specific values live in a board profile, one file per
# /tmp/sysinfo/board_name (docs/hardware-abstraction.md); UCI overrides them.
# These are the 7520/7530 defaults, used if no profile is found.
: "${uart:=/dev/ttyMSM0}"
: "${dect_mode:=0x105}"
: "${fw_firstlevel:=dectfw_firstlevel_441_slow.hex}"
: "${fw_secondlevel:=dectfw_secondlevel_441-07.56.hex}"
: "${factory_mtd:=/dev/mtd5}"
: "${factory_offset:=0x3d000}"
: "${strap:=1}"
: "${led_path:=/sys/class/leds/green:fon/brightness}"
: "${reset_chip:=1000000.pinctrl}"
: "${reset_line:=40}"

dect_load_profile() {
	local b
	b=$(cat /tmp/sysinfo/board_name 2>/dev/null)
	if [ -n "$b" ] && [ -r "/usr/share/opendectcell/boards/$b" ]; then
		. "/usr/share/opendectcell/boards/$b"
	else
		log "no board profile for '${b:-unknown}'; using the 7520 defaults"
	fi
	[ -n "${led_path:-}" ] || led_path=/sys/class/leds/green:fon/brightness
}
dect_load_profile

# The daemon's PCM device and frame size, where the profile names them;
# otherwise the openDECTcell module's /dev/dect0 and its default frame.
PCM_ARGS="${pcm_dev:+-d $pcm_dev}${pcm_slots:+ -c $pcm_slots}"

# A random registration PIN of pin_length digits: 8 (the most GAP allows),
# 6 or 4. The package's uci-defaults script makes one at install; this is
# for a PIN emptied since.
pin_make() {
	local n
	config_get n main pin_length 8
	case "$n" in 4|6|8) ;; *) n=8 ;; esac
	tr -dc 0-9 < /dev/urandom | head -c "$n"
}

# The chip builds openDECTcell was tested with (docs/firmware-sourcing.md;
# tools/dect-fw-extract.py has the same table). Our protocol knowledge
# belongs to these, so anything else is refused unless allowed.
KNOWN_FW="
0d855b5929f8b2ad0b8d8fb38065b32e27f9357cd44a2b4e60573b1b5b6da895
9bdb332678f981d83ac31cf1b68c489ab9c979e2ac601d18b81bb802f16d0d20
7cac33c72b2222468f34033a15c35487aa35062265ab0013bb480068ebab7b31
72f8e27a0d01c301a05a8b373a71887af882a6cebcb1a30bd4a435580e1045f2
4fabee65d07a3214f9083de81ae54089f01bbfccb4cdbb672f37487a09cdfaa6
8aae3b5e3450fd2c9999e003068e786096c11d8ef53f7d47c25cebd057a797d3
"

fw_known() {
	local sum
	sum=$(sha256sum "$1" 2>/dev/null) || return 1
	sum=${sum%% *}
	case "$KNOWN_FW" in *"$sum"*) return 0 ;; esac
	return 1
}

# The DECT UART is also the serial console on this box; a getty on it reads
# the chip's replies away, and kernel messages land in the upload. Freeze a
# running getty (until the next reboot: resuming it hangs up the UART; the
# package's uci-defaults script disables it for good) and quiet the kernel
# console, so neither gets in the way of the firmware upload.
console_claim() {
	local uart="$1" p
	echo 1 > /proc/sys/kernel/printk
	for p in /proc/[0-9]*; do
		[ "$(cat "$p/comm" 2>/dev/null)" = askfirst ] || continue
		ls -l "$p/fd" 2>/dev/null | grep -q "${uart##*/}" || continue
		kill -STOP "${p#/proc/}" &&
			log "froze the console getty on $uart, the DECT UART"
	done
	return 0
}

# A value from UCI (LuCI writes it) must consist of the characters of
# CLASS before it reaches a shell word, a daemon option or a config file
# line: a newline, a space or a comma there adds what the user never set
# (security audit 2026-10-29, F3). uci_ok NAME VALUE CLASS
uci_ok() {
	case "$2" in
	*[!$3]*)
		log "option $1 '$2' has characters it may not have; ignored"
		return 1
		;;
	esac
	return 0
}

# config_get, falling back to DEFAULT when the value fails uci_ok
uci_get() {
	local __v
	config_get __v main "$2" "$3"
	uci_ok "$2" "$__v" "$4" || __v="$3"
	eval "$1=\$__v"
}

# Bench B0 (docs/multicell-identities.md): option rfpi_test, 10 hex digits,
# goes into the STUB image's tag 1 at upload, and dect-stubd says whether
# the chip reports it back (rfpicheck=). Empty: the factory RFPI as always.
# Remove it after the test; the upload only runs when the chip is booted
# afresh (no /var/run/opendectcell/stub.second).
#
# A cell whose controller set a DECT identity (CONFIG_SET, dect-cell writes
# /etc/opendectcell/cell/rfpi) takes that when rfpi_test is not set.
rfpi_test() {
	local v role
	uci_get v rfpi_test '' '0-9A-Fa-f'
	if [ ${#v} -ne 10 ]; then
		config_get role main role base
		[ "$role" = cell ] && [ -r /etc/opendectcell/cell/rfpi ] &&
			v=$(tr -cd '0-9A-Fa-f' < /etc/opendectcell/cell/rfpi 2>/dev/null)
	fi
	[ ${#v} -eq 10 ] && echo "$v"
}

load_chip() {
	local dir first second tty mtd off mode strapv unverified f extra rt
	uci_get dir firmware_dir /etc/opendectcell/firmware 'A-Za-z0-9/._-'
	uci_get first first "$fw_firstlevel" 'A-Za-z0-9._-'
	uci_get second second "$fw_secondlevel" 'A-Za-z0-9._-'
	uci_get tty uart "$uart" 'A-Za-z0-9/'
	uci_get mtd factory_mtd "$factory_mtd" 'A-Za-z0-9/'
	uci_get off factory_offset "$factory_offset" '0-9A-Fa-fx'
	uci_get mode mode "$dect_mode" '0-9A-Fa-fx'
	config_get strapv main strap "$strap"

	[ -r "$dir/$first" ] && [ -r "$dir/$second" ] || {
		log "chip firmware missing in $dir ($first, $second); not starting"
		return 1
	}
	config_get_bool unverified main fw_allow_unverified 0
	for f in "$dir/$first" "$dir/$second"; do
		fw_known "$f" && continue
		if [ "$unverified" = 1 ]; then
			log "WARNING: $f is not a firmware build opendectcell knows; running it anyway (fw_allow_unverified)"
		else
			log "$f is not a firmware build opendectcell knows; not starting. Extract it with tools/dect-fw-extract.py from the FRITZ!OS version in docs/firmware-sourcing.md"
			return 1
		fi
	done
	# No firmware-load UART, no start: the 7362 SL's (USIF) has no driver
	# yet, so its profile names none. Checked before anything is loaded or
	# a getty frozen; an empty name would match every getty.
	[ -n "$tty" ] && [ -c "$tty" ] || {
		log "the DECT chip's UART '${tty:-none}' does not exist on this box; not starting (docs/hardware-abstraction.md)"
		return 1
	}
	# A bus carried by another transport module (pcm_kmod, the 7412's SSC)
	# needs it loaded first: it holds the PCM clock enable, which must be
	# high before the chip leaves reset.
	if [ -n "${pcm_kmod:-}" ]; then
		grep -q "^$pcm_kmod " /proc/modules || insmod "$pcm_kmod" || {
			log "insmod $pcm_kmod failed"
			return 1
		}
	fi
	# the daemon's files: root only, not the world-writable /tmp
	mkdir -p /var/run/opendectcell && chmod 700 /var/run/opendectcell
	# a reset park_guard holds: let go, so the module can claim the line
	# (the upload below runs again, park_guard removed stub.second)
	chip_unhold
	grep -q '^opendectcell ' /proc/modules || insmod opendectcell || {
		log "insmod opendectcell failed"
		return 1
	}
	# Already booted since the last module load: keep it.
	[ -s /var/run/opendectcell/stub.second ] && return 0
	console_claim "$tty"
	extra=""
	[ -n "$mtd" ] && extra="$extra --factory-mtd $mtd --factory-offset $off"
	[ "$strapv" = 0 ] && extra="$extra --no-strap"
	rt=$(rfpi_test) && extra="$extra --rfpi $rt"
	# shellcheck disable=SC2086
	/usr/sbin/dect-fwload --uart "$tty" --dect-dev /dev/dect0 \
		--first "$dir/$first" --second "$dir/$second" --mode "$mode" \
		$extra \
		>/tmp/dect-fwload.log 2>&1 || {
		log "chip firmware upload failed, see /tmp/dect-fwload.log"
		rm -f /var/run/opendectcell/stub.second
		return 1
	}
	# dect-stubd reads this to know which build's RAM addresses apply.
	echo "$second" > /var/run/opendectcell/stub.second
	chip_fresh=$second
}

# The first daemon run on a chip just uploaded gets no answer to memory reads
# on 08.25 (bench 2026-10-31, again with the cell's audit on 2026-11-01), so a
# cell could not check its key table. One short run that only parks the radio
# gets the chip past it; the real daemon is then the second run.
warm_chip() {
	log "chip freshly uploaded: one short run to warm it"
	# shellcheck disable=SC2086
	$PROG $PCM_ARGS -M "0x22:0x02:0x022c:01" -M "0x22:0x02:0x015b:00" -t 6 \
		>/tmp/dect-warm.log 2>&1
}

# The chip's reset line in /sys/class/gpio: the board profile's GPIO chip
# label and line (the openDECTcell module's own lookup table), its number the
# chip's base plus the line.
reset_gpio() {
	local c b
	for c in /sys/class/gpio/gpiochip*; do
		[ "$(cat "$c/label" 2>/dev/null)" = "$reset_chip" ] || continue
		b=$(cat "$c/base") || return 1
		echo $((b + reset_line))
		return 0
	done
	return 1
}

chip_unhold() {
	local n
	n=$(reset_gpio) || return 0
	[ -d "/sys/class/gpio/gpio$n" ] && echo "$n" > /sys/class/gpio/unexport
	return 0
}

# A chip whose park dect-stubd did not confirm goes into reset at the stop,
# so nothing transmits whatever the daemon left behind: a crash, a kill
# after term_timeout, a park the chip read back as not done. The daemon
# writes /var/run/opendectcell/parked when the park is done (read back, or for
# a STUB build it cannot read back, the park mails on the wire). A chip we
# did not boot (no stub.second) is left alone.
park_guard() {
	local i=0 n
	[ -s /var/run/opendectcell/stub.second ] || return 0
	while pidof dect-stubd >/dev/null && [ $i -lt 15 ]; do
		sleep 1
		i=$((i + 1))
	done
	[ -e /var/run/opendectcell/parked ] && return 0
	n=$(reset_gpio) &&
	{ [ -d "/sys/class/gpio/gpio$n" ] || echo "$n" > /sys/class/gpio/export; } &&
	echo low > "/sys/class/gpio/gpio$n/direction" || {
		log "RADIO MAY STILL TRANSMIT: the park was not confirmed and the chip's reset line ($reset_chip $reset_line) could not be held"
		return 1
	}
	rm -f /var/run/opendectcell/stub.second
	log "the park was not confirmed: the DECT chip is held in reset (GPIO $n); the next start uploads its firmware again"
}

service_stopped() {
	park_guard
}

# A handset's own settings (Network > DECT, Handsets, General): each
# 'list override key=value' of its 'config handset' section becomes a line
# of /etc/opendectcell/handset<slot>.override, which dect-stubd lays over the
# handset's profile. Written afresh at every start.
OVERRIDE_DIR=/etc/opendectcell

override_line() {
	local kv="$1" slot="$2" k v
	k=${kv%%=*}
	v=${kv#*=}
	# a key and a value as the profile format has them, nothing else
	case "$k" in *[!a-z0-9._]*|"") return ;; esac
	case "$v" in *[!A-Za-z0-9x:{}_\ -]*|"") return ;; esac
	printf '%s = %s\n' "$k" "$v" >> "$OVERRIDE_DIR/handset$slot.override"
}

override_write() {
	local slot
	config_get slot "$1" slot
	case "$slot" in [1-6]) ;; *) return ;; esac
	config_list_foreach "$1" override override_line "$slot"
}

overrides_write() {
	mkdir -p "$OVERRIDE_DIR"
	rm -f "$OVERRIDE_DIR"/handset*.override "$OVERRIDE_DIR"/handset*.lines
	config_foreach override_write handset
	lines_resolve
	config_foreach lines_write handset
}

# A handset's Line 1 and Line 2 are VoIP profiles ('config voip' sections,
# Network > DECT, VoIP Profiles), named by its options line1 and line2.
# Resolved once per start (overrides_write) into LINE_<slot>_<n>, which
# lines_write and baresip_write read. A profile may be a line of several
# handsets (a call to it rings them all), but not both lines of one
# handset.
lines_resolve_one() {
	local sec="$1" slot n p t first=
	config_get slot "$sec" slot
	case "$slot" in [1-6]) ;; *) return ;; esac
	for n in 1 2; do
		config_get p "$sec" line$n
		[ -n "$p" ] || continue
		config_get t "$p" TYPE
		if [ "$t" != voip ]; then
			log "DECT $slot line $n: there is no VoIP profile '$p'; line left out"
			continue
		fi
		if [ "$p" = "$first" ]; then
			log "DECT $slot line $n: VoIP profile '$p' is already its Line 1; left out"
			continue
		fi
		first=$p
		eval "LINE_${slot}_$n=\$p"
	done
}

lines_resolve() {
	local s
	for s in 1 2 3 4 5 6; do
		eval "LINE_${s}_1= LINE_${s}_2="
	done
	config_foreach lines_resolve_one handset
}

# A handset's line names: "<line> <name>" in /etc/opendectcell/handset<slot>.lines,
# from each assigned profile's line_name, else its name if that fits the
# list's 15 octets; Line 1 always, Line 2 only with a profile. The handset's
# Line Settings List shows them.
line_name() {
	printf '%s' "$1" | tr -d '\000-\037'
}

lines_write() {
	local slot n p v f
	config_get slot "$1" slot
	case "$slot" in [1-6]) ;; *) return ;; esac
	f="$OVERRIDE_DIR/handset$slot.lines"
	: > "$f"
	for n in 1 2; do
		eval "p=\$LINE_${slot}_$n"
		if [ -z "$p" ]; then
			[ "$n" = 1 ] && printf '1 Line 1\n' >> "$f"
			continue
		fi
		config_get v "$p" line_name
		if [ -z "$v" ]; then
			config_get v "$p" name
			[ ${#v} -le 15 ] || v="Line $n"
		fi
		printf '%s %s\n' "$n" "$(line_name "$v")" >> "$f"
	done
	return 0
}

# The SIP side (Network > DECT, VoIP Profiles, assigned under Handsets):
# baresip with the openDECTcell module as the bridge (docs/bridge-interface.md),
# its config and accounts written here from /etc/config/opendectcell, and the
# line map /var/run/opendectcell/lines ("<hs> <line> <aor>") the module reads.
BARESIP=/usr/bin/baresip
BS_DIR=/var/run/opendectcell/baresip
BS_MODS=/usr/lib/baresip/modules
BS_ACCOUNTS=0

# a value for an account parameter: no ; " < > or whitespace
bs_safe() {
	case "$1" in *[\;\"\<\>\ \	]*) return 1 ;; esac
	return 0
}

bs_line() {
	local slot="$1" n="$2" sec v user dom aor line codecs c auto
	eval "sec=\$LINE_${slot}_$n"
	[ -n "$sec" ] || return 0
	config_get user "$sec" user
	config_get dom "$sec" domain
	[ -n "$user" ] && [ -n "$dom" ] && bs_safe "$user" && bs_safe "$dom" || {
		log "DECT $slot line $n: profile '$sec' has no usable user name or registrar; line left out"
		return 0
	}
	aor="sip:$user@$dom"
	# a profile shared by handsets is one baresip account, written once
	case "$BS_SECS" in
	*" $sec "*)
		printf '%s %s %s\n' "$slot" "$n" "$aor" >> /var/run/opendectcell/lines
		return 0
		;;
	esac
	# two profiles with the same account would be one baresip account
	case "$BS_AORS" in
	*" $aor "*)
		log "DECT $slot line $n: profile '$sec' has the account $aor of another line; left out"
		return 0
		;;
	esac
	BS_AORS="$BS_AORS$aor "
	BS_SECS="$BS_SECS$sec "
	config_get v "$sec" transport udp
	line="<$aor"
	[ "$v" = udp ] || line="$line;transport=$v"
	line="$line>"
	config_get v "$sec" display
	v=$(printf '%s' "$v" | tr -d '"<>\\')
	[ -n "$v" ] && line="\"$v\" $line"
	config_get v "$sec" authuser
	[ -n "$v" ] && bs_safe "$v" && line="$line;auth_user=$v"
	config_get v "$sec" password
	if [ -n "$v" ]; then
		bs_safe "$v" && line="$line;auth_pass=$v" ||
			log "DECT $slot line $n: the password has a character baresip cannot take (; \" < > or a space)"
	fi
	config_get v "$sec" outbound
	[ -n "$v" ] && bs_safe "$v" && line="$line;outbound=\"sip:$v\""
	config_get v "$sec" outbound2
	[ -n "$v" ] && bs_safe "$v" && line="$line;outbound2=\"sip:$v\""
	config_get_bool v "$sec" register 1
	if [ "$v" = 1 ]; then
		config_get v "$sec" regint 3600
		line="$line;regint=$v"
	else
		line="$line;regint=0"
	fi
	config_get_bool v "$sec" sipnat 0
	[ "$v" = 1 ] && line="$line;sipnat=outbound"
	config_get v "$sec" medianat
	case "$v" in
	stun|turn|ice)
		line="$line;medianat=$v"
		config_get c "$sec" stunserver
		[ -n "$c" ] && bs_safe "$c" && line="$line;stunserver=\"$([ "$v" = turn ] && echo turn || echo stun):$c\""
		config_get c "$sec" stunuser
		[ -n "$c" ] && bs_safe "$c" && line="$line;stunuser=$c"
		config_get c "$sec" stunpass
		[ -n "$c" ] && bs_safe "$c" && line="$line;stunpass=$c"
		;;
	esac
	config_get v "$sec" rtpkeep
	case "$v" in zero|stun|dyna|rtcp) line="$line;rtpkeep=$v" ;; esac
	# Media "try to autodetect" (the default): every codec offered, HD
	# first, and key tones as the other side's offer says
	config_get_bool auto "$sec" media_auto 1
	if [ "$auto" = 1 ]; then
		line="$line;audio_codecs=G722/16000/1,PCMA/8000/1,PCMU/8000/1;ptime=20;dtmfmode=auto;100rel=yes"
	else
		config_get v "$sec" codec 'g722 pcma pcmu'
		codecs=""
		for c in $v; do
			case "$c" in g722) c=G722/16000/1 ;; pcma) c=PCMA/8000/1 ;; pcmu) c=PCMU/8000/1 ;; *) continue ;; esac
			codecs="${codecs:+$codecs,}$c"
		done
		[ -n "$codecs" ] && line="$line;audio_codecs=$codecs"
		config_get v "$sec" ptime 20
		case "$v" in 10|20|30|40) line="$line;ptime=$v" ;; esac
		config_get v "$sec" dtmf rtpevent
		case "$v" in rtpevent|info|auto) line="$line;dtmfmode=$v" ;; esac
		config_get v "$sec" rel100 yes
		case "$v" in yes|no|required) line="$line;100rel=$v" ;; esac
	fi
	config_get_bool v "$sec" mwi 0
	line="$line;mwi=$([ "$v" = 1 ] && echo yes || echo no)"
	config_get_bool v "$sec" transfer 1
	line="$line;call_transfer=$([ "$v" = 1 ] && echo yes || echo no)"
	# Encryption "try to autodetect" (the default): SRTP offered, plain
	# RTP when the other side does not take it
	config_get_bool auto "$sec" enc_auto 1
	if [ "$auto" = 1 ]; then
		if [ -f "$BS_MODS/srtp.so" ]; then
			line="$line;mediaenc=srtp"
		else
			log "DECT $slot line $n: baresip-mod-srtp is not installed; speech goes unencrypted"
		fi
	else
		config_get v "$sec" mediaenc
		case "$v" in srtp|srtp-mand|srtp-mandf|dtls_srtp) line="$line;mediaenc=$v" ;; esac
	fi
	line="$line;answermode=manual"
	config_get v "$sec" extra
	case "$v" in ";"*) line="$line$v" ;; esac
	printf '%s\n' "$line" >> "$BS_DIR/accounts"
	printf '%s %s %s\n' "$slot" "$n" "$aor" >> /var/run/opendectcell/lines
	BS_ACCOUNTS=$((BS_ACCOUNTS + 1))
}

bs_handset() {
	local slot
	config_get slot "$1" slot
	case "$slot" in [1-6]) ;; *) return ;; esac
	bs_line "$slot" 1
	bs_line "$slot" 2
}

bs_module() {
	[ -f "$BS_MODS/$2" ] && printf '%s %s\n' "$1" "$2" >> "$BS_DIR/config"
	return 0
}

# Write baresip's files from the lines lines_resolve found; 0 when at
# least one handset has a usable line.
baresip_write() {
	local v lo hi
	BS_ACCOUNTS=0
	[ -x "$BARESIP" ] && [ -f "$BS_MODS/opendectcell.so" ] || return 1
	mkdir -p "$BS_DIR"
	chmod 700 /var/run/opendectcell "$BS_DIR"
	: > "$BS_DIR/accounts"
	chmod 600 "$BS_DIR/accounts"
	: > /var/run/opendectcell/lines
	BS_AORS=" "
	BS_SECS=" "
	config_foreach bs_handset handset
	[ "$BS_ACCOUNTS" -gt 0 ] || return 1
	{
		echo "# written by /etc/init.d/opendectcell from /etc/config/opendectcell"
		uci_get v sip_port 5060 '0-9'
		echo "sip_listen 0.0.0.0:$v"
		uci_get v rtp_ports '10000-20000' '0-9-'
		echo "rtp_ports $v"
		uci_get v rtp_dscp 46 '0-9'
		echo "rtp_tos $((v * 4))"
		uci_get v sip_dscp 24 '0-9'
		echo "sip_tos $((v * 4))"
		uci_get v net_interface '' 'A-Za-z0-9._-'
		[ -n "$v" ] && echo "net_interface $v"
		config_get v main dns_server
		uci_ok dns_server "$(printf '%s' "$v" | tr -d '[]')" \
			'0-9A-Fa-f.:' || v=
		# baresip wants IP:port; a bare address gets port 53
		case "$v" in
		"") ;;
		*.*.*.*:*|\[*\]:*) echo "dns_server $v" ;;
		*:*) echo "dns_server [$v]:53" ;;
		*) echo "dns_server $v:53" ;;
		esac
		config_get_bool v main tls_verify 1
		echo "sip_verify_server $([ "$v" = 1 ] && echo yes || echo no)"
		uci_get v tls_cafile '' 'A-Za-z0-9/._-'
		[ -n "$v" ] && echo "sip_cafile $v"
		uci_get v jitter '20-160' '0-9-'
		lo=${v%-*}; hi=${v#*-}
		echo "audio_jitter_buffer_type adaptive"
		echo "audio_jitter_buffer_delay $(( (lo + 19) / 20 ))-$(( (hi + 19) / 20 ))"
		echo "audio_player opendectcell,"
		echo "audio_source opendectcell,"
		# no ausrc_srate/auplay_srate: each call's audio runs at its
		# SIP codec's rate, so a G.711 call is resampled nowhere
		echo "ausrc_channels 1"
		echo "auplay_channels 1"
		echo "module_path $BS_MODS"
		# INVITEs only from where an account registers (its REGISTER's
		# 2xx); sip_any_source '1' for a provider calling from elsewhere
		config_get_bool v main sip_any_source 0
		[ "$v" = 1 ] && echo "opendectcell_any_source yes"
	} > "$BS_DIR/config"
	# auresamp: baresip's core drops frames whose rate is not the
	# codec's; the bridge's are, unless a codec changes mid-call or the
	# two ends share no codec. opendectcell.so is the G.722 codec too (the
	# octets passed as they are, not baresip's g722.so), so it loads
	# before account.so, whose accounts name it.
	for v in auresamp.so g711.so opendectcell.so stun.so turn.so ice.so srtp.so dtls_srtp.so mwi.so; do
		bs_module module "$v"
	done
	bs_module module_app account.so
	return 0
}

# Cell mode (option role 'cell'): the box is a cell of an openDECTcell controller
# (opendectcell-controller docs/cell-protocol.md §14.1). The controller runs the
# DECT stack and the SIP lines, so nothing of the base starts here: no
# handsets, no PIN, no baresip. dect-stubd -K tunnels the chip's mails
# and keeps the radio parked until the controller turns it on; dect-cell
# holds the TLS link.
start_cell() {
	if [ ! -x "$CELL" ]; then
		log "cell mode needs the package opendectcell-cell; nothing started"
		return 1
	fi
	procd_open_instance
	local rt lo
	rt=$(rfpi_test)
	lo=${rt:+rfpicheck=$rt}
	# the DECT LED follows the radio the controller turned on
	[ -n "${led_path:-}" ] && lo="${lo:+$lo,}led=$led_path"
	procd_set_param command $PROG $PCM_ARGS -K ${lo:+-a $lo}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_set_param respawn 3600 5 5
	procd_close_instance
	procd_open_instance cell
	# plain RTP for the controller's media: unencrypted calls, so only by
	# the admin's choice (cell-protocol.md §8.1)
	local plain
	config_get_bool plain main cell_plain_rtp 0
	if [ "$plain" = 1 ]; then
		procd_set_param command "$CELL" -P run
	else
		procd_set_param command "$CELL" run
	fi
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
	[ -s /etc/opendectcell/cell/enrollment ] ||
		log "cell mode, but not enrolled: run 'enroll' or use Network > DECT"
}

start_service() {
	local enabled pin stores options reg wb ov dw ci nocipher="" rw n spare f args="" rt
	local cdav contacts=""
	local la tc tu role
	config_load opendectcell
	config_get_bool enabled main enabled 0
	if [ "$enabled" != 1 ]; then
		# switched off by Save & Apply: procd stops the daemon after
		# this returns, and no service_stopped follows
		pidof dect-stubd >/dev/null &&
			( park_guard ) </dev/null >/dev/null 2>&1 &
		return 0
	fi

	config_get role main role base
	# A cell never inherits the chip's key table: the chip keeps it across
	# daemon runs, so a box that served handsets on its own would still
	# admit them. Booting the chip afresh empties it (L8); the cell's host
	# stack then writes one dummy key, so the radio has a key to run on.
	[ "$role" = cell ] && rm -f /var/run/opendectcell/stub.second
	chip_fresh=""
	load_chip || return 1
	rm -f /var/run/opendectcell/parked
	if [ "$role" = cell ]; then
		[ "$chip_fresh" = dectfw_secondlevel_441.hex ] && warm_chip
		start_cell
		return
	fi
	overrides_write
	uci_get pin pin '' '0-9'
	if [ -z "$pin" ]; then
		pin=$(pin_make)
		uci -q set opendectcell.main.pin="$pin" && uci -q commit opendectcell
		log "made a registration PIN (Network > DECT, Handsets shows it)"
	fi
	uci_get stores stores '/etc/opendectcell-sub.*' 'A-Za-z0-9/._*-'
	# The audio bind (TDM slot mask 0x0002, narrowband bind byte 3) and
	# the 8 s connection-status poll that Status > DECT's radio figures
	# come from: the daemon has no defaults for them. The user's options
	# follow, so a key set there again wins (the daemon takes the last).
	config_get options main options ''
	options="mask=0x0002,codec=3,status=8000${options:+,$options}"
	config_get_bool reg main registration 0
	[ "$reg" = 1 ] && options="${options:+$options,}regopen"
	config_get_bool wb main wideband 1
	[ "$wb" = 1 ] || options="${options:+$options,}narrowband"
	config_get_bool ov main overlap 1
	uci_get dw dialwait 3000 '0-9'
	if [ "$ov" = 1 ]; then
		options="${options:+$options,}dialwait=$dw"
	else
		options="${options:+$options,}nooverlap"
	fi
	# ciphered calls unless turned off (-C: the link in the clear)
	config_get_bool ci main cipher 1
	[ "$ci" = 1 ] || nocipher="-C"
	uci_get rw regwindow 120 '0-9'
	options="${options:+$options,}regwindow=$rw"
	# authentication on location registration: the daemon's default
	config_get_bool la main locauth 1
	[ "$la" = 1 ] || options="${options:+$options,}nolocauth"
	config_get_bool tc main twocalls 1
	[ "$tc" = 1 ] && options="${options:+$options,}twocalls"
	rt=$(rfpi_test) && options="${options:+$options,}rfpicheck=$rt"
	# Hours between date and time updates to every handset (0: only when
	# one reports in); the daemon counts minutes. A timeupdate= (minutes)
	# in options wins.
	uci_get tu time_update 24 '0-9'
	tu=${tu#"${tu%%[!0]*}"}
	{ [ ${#tu} -le 3 ] && [ "${tu:-0}" -le 720 ]; } || tu=24
	case ",$options," in
	*,timeupdate=*) ;;
	*) options="${options:+$options,}timeupdate=$((${tu:-0} * 60))" ;;
	esac
	# The DECT LED path is a board-profile detail (e.g. green:fon on the
	# 7520, green:dect on the 7412). The user can turn the LED off with
	# 'noled' or point it elsewhere with 'led=PATH' in options.
	if [ -n "${led_path:-}" ]; then
		case ",$options," in
		*,led=*|*,noled,*) ;;
		*) options="${options:+$options,}led=$led_path" ;;
		esac
	fi
	# the stores only: not their side files (.name, .profile,
	# .deregistered, ...), which share the pattern
	for f in $stores; do
		case "${f#"${stores%%\**}"}" in *.*) continue ;; esac
		[ -s "$f" ] && args="$args -s $f"
	done
	# and two stores that do not exist yet: where `register` puts new
	# handsets (a known one re-enrols into its own)
	spare=0
	for n in 1 2 3 4 5 6; do
		f="${stores%%\**}$n"
		[ -s "$f" ] && continue
		args="$args -s $f"
		spare=$((spare + 1))
		[ $spare -ge 2 ] && break
	done

	# The handsets' Contact List from a CardDAV address book (package
	# opendectcell-carddav): dect-stubd offers what the sync writes, and the
	# sync writes back what handsets change. Both stop with the service.
	config_get_bool cdav carddav enabled 0
	[ "$cdav" = 1 ] && [ -f "$CARDDAV" ] && contacts="-b /var/run/opendectcell/contacts"

	procd_open_instance
	# the PIN through a root-only file: on the command line every local
	# user could read it in /proc (security audit 2026-10-29, F2)
	( umask 077; printf '%s\n' "$pin" > /var/run/opendectcell/pin )
	procd_set_param command $PROG $PCM_ARGS -g -P @/var/run/opendectcell/pin \
		$nocipher $args $contacts \
		${options:+-a "$options"}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	# a crash restarts it; five quick failures in a row give up
	procd_set_param respawn 3600 5 5
	procd_close_instance

	if [ -n "$contacts" ]; then
		procd_open_instance carddav
		procd_set_param command /usr/bin/ucode "$CARDDAV"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param respawn 3600 30 5
		procd_close_instance
	fi

	# the SIP side, when a handset has a line
	if baresip_write; then
		procd_open_instance baresip
		procd_set_param command "$BARESIP" -f "$BS_DIR"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param respawn 3600 5 5
		procd_close_instance
		log "SIP: $BS_ACCOUNTS line(s), baresip with the opendectcell bridge"
	fi
}

# Save & Apply in LuCI (Network > DECT) restarts the base with the new
# settings; a call in progress ends.
service_triggers() {
	procd_add_reload_trigger "opendectcell"
}

# After a deregistration (LuCI, Handsets): the handset's section goes from
# /etc/config/opendectcell, committed on its own, so changes the user saved but
# has not applied stay pending and are not applied with it. Its VoIP
# profiles stay, free; baresip restarts only if it had a line.
forget() {
	local slot="$1" l1 l2
	case "$slot" in
	[1-6]) ;;
	*) echo "usage: $0 forget <1-6>" >&2; return 1 ;;
	esac
	[ -n "$(uci -q get "opendectcell.dect$slot")" ] || return 0
	l1=$(uci -q get "opendectcell.dect$slot.line1")
	l2=$(uci -q get "opendectcell.dect$slot.line2")
	uci -q delete "opendectcell.dect$slot" && uci -q commit opendectcell || return 1
	rm -f "$OVERRIDE_DIR/handset$slot.override" "$OVERRIDE_DIR/handset$slot.lines"
	log "DECT $slot's settings removed"
	if [ -n "$l1$l2" ] && pidof dect-stubd >/dev/null; then
		log "DECT $slot had a line: restarting for the SIP side"
		/etc/init.d/opendectcell restart
	fi
	return 0
}

# Open the registration window on the running daemon: 'regwindow' seconds,
# closed again after one handset enrols. The command-line way; LuCI uses
# the control socket (register-window).
register() {
	local pid
	[ "$(uci -q get opendectcell.main.role)" = cell ] &&
		{ log "cell mode: the controller registers handsets"; return 1; }
	pid=$(pidof dect-stubd) || { log "not running"; return 1; }
	kill -USR1 $pid && log "registration open"
}

enroll() {
	local rc
	[ -x "$CELL" ] || { log "needs the package opendectcell-cell"; return 1; }
	[ -n "$1" ] || { log "usage: enroll '<enrollment string>' | @<file>"; return 1; }
	# LuCI hands the string over in a root-only file, so it is never in
	# a process's command line; that file goes when the enrolment is over
	"$CELL" enroll "$1"
	rc=$?
	case "$1" in
	@/tmp/opendectcell-enroll.*)
		case "$1" in *..*) ;; *) rm -f "${1#@}" ;; esac ;;
	esac
	[ $rc -eq 0 ] || return 1
	uci -q set opendectcell.main.role=cell && uci -q commit opendectcell
	log "enrolled: cell mode from now on"
	restart
}

cell_leave() {
	[ -x "$CELL" ] && "$CELL" forget
	uci -q set opendectcell.main.role=base && uci -q commit opendectcell
	log "cell mode left: the base runs with the handsets it had"
	# a chip patched with the system's identity goes back to the factory one
	rm -f /var/run/opendectcell/stub.second
	restart
}
