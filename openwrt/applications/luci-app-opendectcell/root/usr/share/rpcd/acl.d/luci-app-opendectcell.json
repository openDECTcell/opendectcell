{
	"luci-app-opendectcell": {
		"description": "Read the DECT base's state, change its settings and manage its handsets",
		"read": {
			"file": {
				"/var/run/opendectcell/state.json": [ "read" ],
				"/var/run/opendectcell-sip/voip.json": [ "read" ],
				"/tmp/run/opendectcell/state.json": [ "read" ],
				"/tmp/run/opendectcell-sip/voip.json": [ "read" ],
				"/etc/opendectcell/profiles": [ "list" ],
				"/etc/opendectcell-sub.*.profile": [ "read" ],
				"/etc/opendectcell/profiles/*.profile": [ "read" ],
				"/tmp/sysinfo/board_name": [ "read" ],
				"/usr/share/opendectcell/boards/*": [ "read" ],
				"/sbin/logread": [ "exec" ],
				"/sbin/logread -l 2000": [ "exec" ],
				"/var/run/opendectcell/cell.json": [ "read" ],
				"/var/run/opendectcell/cell-link.json": [ "read" ],
				"/tmp/run/opendectcell/cell.json": [ "read" ],
				"/tmp/run/opendectcell/cell-link.json": [ "read" ],
				"/usr/sbin/dect-cell": [ "list" ],
				"/usr/share/opendectcell/carddav.uc": [ "list" ],
				"/var/run/opendectcell/carddav.json": [ "read" ],
				"/tmp/run/opendectcell/carddav.json": [ "read" ],
				"/var/run/opendectcell/carddav-books.json": [ "read" ],
				"/tmp/run/opendectcell/carddav-books.json": [ "read" ],
				"/usr/share/opendectcell/firmware.sh status": [ "exec" ]
			},
			"ubus": {
				"service": [ "list" ]
			},
			"uci": [ "opendectcell" ]
		},
		"write": {
			"file": {
				"/etc/init.d/opendectcell forget [1-6]": [ "exec" ],
				"/etc/init.d/opendectcell start": [ "exec" ],
				"/usr/sbin/dect-stubd --ctl deregister hs=[1-6]": [ "exec" ],
				"/usr/sbin/dect-stubd --ctl rename hs=[1-6] name=*": [ "exec" ],
				"/usr/sbin/dect-stubd --ctl reload-profiles": [ "exec" ],
				"/usr/sbin/dect-stubd --ctl register-window*": [ "exec" ],
				"/usr/sbin/dect-stubd --profile-keys": [ "exec" ],
				"/etc/opendectcell-sub.*.profile": [ "write" ],
				"/etc/init.d/opendectcell ui_dir": [ "exec" ],
				"/etc/init.d/opendectcell enroll @/var/run/opendectcell-ui/opendectcell-enroll.*": [ "exec" ],
				"/var/run/opendectcell-ui/opendectcell-enroll.*": [ "write" ],
				"/etc/init.d/opendectcell cell_leave": [ "exec" ],
				"/var/run/opendectcell-ui/opendectcell-carddav-discover.json": [ "write" ],
				"/usr/share/opendectcell/carddav.uc discover /var/run/opendectcell-ui/opendectcell-carddav-discover.json": [ "exec" ],
				"/var/run/opendectcell-ui/opendectcell-fw-upload.first": [ "write" ],
				"/var/run/opendectcell-ui/opendectcell-fw-upload.second": [ "write" ],
				"/usr/share/opendectcell/firmware.sh install first /var/run/opendectcell-ui/opendectcell-fw-upload.first": [ "exec" ],
				"/usr/share/opendectcell/firmware.sh install second /var/run/opendectcell-ui/opendectcell-fw-upload.second": [ "exec" ],
				"/usr/share/opendectcell/firmware.sh delete first": [ "exec" ],
				"/usr/share/opendectcell/firmware.sh delete second": [ "exec" ]
			},
			"cgi-io": [ "upload" ],
			"uci": [ "opendectcell" ]
		}
	}
}
