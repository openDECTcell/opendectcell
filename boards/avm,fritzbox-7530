# openDECTcell board profile: AVM FRITZ!Box 7520 / 7530 (IPQ4019, ADSS TDM).
# Installed as /usr/share/opendectcell/boards/avm,fritzbox-7530.
# Read by /etc/init.d/opendectcell; UCI options in /etc/config/opendectcell override.
# Keys: see docs/hardware-abstraction.md section 4.

name=FRITZ!Box 7520
transport=ipq40xx-tdm

fw_family=441
fw_firstlevel=dectfw_firstlevel_441_slow.hex
fw_secondlevel=dectfw_secondlevel_441-07.56.hex

dect_mode=0x105

# Firmware-load UART (shared with the serial console).
uart=/dev/ttyMSM0
uart_is_console=1

# The DECT/Fon LED driven by dect-stubd while the base runs.
led_path=/sys/class/leds/green:fon/brightness

# Factory DECT config block (RFPI and calibration).
factory_mtd=/dev/mtd5
factory_offset=0x3d000

max_calls=3
