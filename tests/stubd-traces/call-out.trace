# A stored handset dials out en bloc; the bridge places the call, the far
# end answers and later hangs up. Identities, keys and numbers are made up.
sub 1 80 a8 03 11 22 33 44
start
ev hello api=N lines=1 hs=1
ev hs hs=1 state=registered name="DECT 1" wideband=1
mail 0153 00
mail 0169 07
mail 0157 00
mail 015b 01
mail 022c 01
mail 0247 02 00 00
mail 0247 03 00 00
mail 0247 04 00 00
mail 0247 05 00 00
mail 0247 06 00 00
mail fff1 07 18 95 00 00 11 00
mail fff1 07 29 95 00 00 11 00
mail fff1 07 3a 95 00 00 11 00
mail fff1 07 4b 95 00 00 11 00
mail fff1 07 5c 95 00 00 11 00
mail fff1 07 6d 95 00 00 11 00
mail 0247 01 01 00
mail 020a 01 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 ba bb bc bd be bf 00
mail fff1 07 18 95 00 00 11 00
mail 017c 00 01
ctl bridge
ev ok verb=bridge

up 1
# {CC-SETUP}: <<PORTABLE-IDENTITY>>, <<FIXED-IDENTITY>> (PARK),
# <<BASIC-SERVICE>> normal call, basic speech; <<MULTI-KEYPAD>> "0301234";
# <<SENDING-COMPLETE>>.
pp 03 05 05 07 80 a8 03 11 22 33 44 06 07 a0 a5 00 01 23 45 60 e0 80 2c 07 30 33 30 31 32 33 34 a1
fp 83 02 7e 06 01 00 81 02 01 83
fp 05 40 0a 03 01 18 18 0c 08 cb f0 15 3a 5f 84 a9 ce 0e 08 f3 18 3d 62 87 ac d1 f6
tick 200
# The base authenticates for ciphering. RES1 for the made-up UAK and this
# RAND_F and RS (the harness's randomness is fixed, but this trace draws
# it in another order than locate.trace).
pp 85 41 0d 04 89 ab a4 b5
ev call-out call=1 hs=1 line=1 codec=nb number=0301234
fp 05 4c 19 02 81 98
mail 0208 01 a8 ba 8e f2 1c 8a d6 d6 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 ff ff 00 00
tick 200
chip 0209 01
tick 500
# The far end rings, then answers.
ctl remote-ringing call=1
ev ok verb=remote-ringing call=1
fp 83 01 7e 06 01 00 81 02 01 84
tick 200
ctl remote-answered call=1
ev ok verb=remote-answered call=1
fp 83 07 7e 06 01 00 81 02 01 85
ev audio call=1 path=build/stubd-test-run/audio.sock
mail 0251 01 01 2b
mail 0230 01 01 00 00 00 00
tick 500
mail 022d 01 00
# The handset hangs up: {CC-RELEASE}, <<RELEASE-REASON>> normal.
pp 03 4d e2 00
ev released call=1 hs=1 by=hs
fp 83 5a
mail 0233 01 01
mail 0202 01
tick 500
down
tick 1000
