{
	"luci-app-opendectcell": {
		"description": "Read the DECT base's state and config, open registration",
		"read": {
			"file": {
				"/tmp/opendectcell-state.json": [
					"read"
				]
			},
			"uci": [
				"opendectcell"
			]
		},
		"write": {
			"file": {
				"/etc/init.d/opendectcell register": [
					"exec"
				]
			}
		}
	}
}
