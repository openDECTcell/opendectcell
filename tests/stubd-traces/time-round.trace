# The periodic date and time (-a timeupdate=1, TS 102 527-3 §7.4.2.1):
# after a minute the base pages DECT 1, which has no link (C-plane page);
# it answers, gets the date and time in a {FACILITY}, and the base
# releases the link it brought up. -C: no ciphering. Identities, keys and
# numbers are made up.
sub 1 80 a8 03 11 22 33 44
args -C -a timeupdate=1
start
ev hello api=N lines=1 hs=1
ev hs hs=1 state=registered name="DECT 1" wideband=1
mail 0153 00
mail 0169 07
mail 0157 00
mail 015b 01
mail 022c 01
mail 0247 02 00 00
mail 0247 03 00 00
mail 0247 04 00 00
mail 0247 05 00 00
mail 0247 06 00 00
mail 0247 01 01 00
mail 020a 01 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 ba bb bc bd be bf 00
mail 017c 00 01
tick 30000
mail fff1 07 18 95 00 00 11 00
mail fff1 07 29 95 00 00 11 00
mail fff1 07 3a 95 00 00 11 00
mail fff1 07 4b 95 00 00 11 00
mail fff1 07 5c 95 00 00 11 00
mail fff1 07 6d 95 00 00 11 00
mail fff1 07 18 95 00 00 11 00
mail fff1 07 18 95 00 00 11 00
tick 30500
mail 0300 08 11 01
mail f600
# DECT 1 answers the page on handle 1: {LCE-PAGE-RESPONSE}.
up 1
pp 00 71 05 07 80 a8 03 11 22 33 44
fp 64 62 23 08 c0 26 10 30 09 01 00 00
mail 0202 01
tick 1000
tick 5000
down
tick 1000
