# Call waiting on one link (TS 102 527-3 §7.4.3): DECT 1 is in a call
# out when the bridge offers it a second call. The handset accepts it,
# holding the first (control code 35H), toggles back (31H), then releases
# the second (33H), and finally hangs up. -C: no ciphering. Identities,
# keys and numbers are made up.
sub 1 80 a8 03 11 22 33 44
args -C
start
ev hello api=N lines=1 hs=1
ev hs hs=1 state=registered name="DECT 1" wideband=1
mail 0153 00
mail 0169 07
mail 0157 00
mail 015b 01
mail 022c 01
mail 0247 02 00 00
mail 0247 03 00 00
mail 0247 04 00 00
mail 0247 05 00 00
mail 0247 06 00 00
mail 0247 01 01 00
mail 020a 01 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 ba bb bc bd be bf 00
mail 017c 00 01
ctl bridge
ev ok verb=bridge

up 1
# {CC-SETUP} from DECT 1, en bloc: "0301234", <<SENDING-COMPLETE>>.
pp 03 05 05 07 80 a8 03 11 22 33 44 06 07 a0 a5 00 01 23 45 60 e0 80 2c 07 30 33 30 31 32 33 34 a1
ev call-out call=1 hs=1 line=1 codec=nb number=0301234
fp 83 02 7e 06 01 00 81 02 01 83
tick 200
mail fff1 07 18 95 00 00 11 00
mail fff1 07 29 95 00 00 11 00
mail fff1 07 3a 95 00 00 11 00
mail fff1 07 4b 95 00 00 11 00
mail fff1 07 5c 95 00 00 11 00
mail fff1 07 6d 95 00 00 11 00
mail fff1 07 18 95 00 00 11 00
ctl remote-answered call=1
ev ok verb=remote-answered call=1
fp 83 07 7e 06 01 00 81 02 01 85
ev audio call=1 path=build/stubd-test-run/audio.sock
mail 0251 01 01 2b
mail 0230 01 01 00 00 00 00
tick 500
mail fff1 07 18 95 00 00 11 00
mail 022d 01 00
# A second call for DECT 1: call waiting in {CC-INFO}.
ctl call-in line=1 hs=1 number=0307654321 name="Second" sip=t2
ev ringing call=2 hs=1
ev call-in-ok call=2 sip=t2
fp 83 7b e4 07 6c 0c 00 80 30 33 30 37 36 35 34 33 32 31 6d 07 04 53 65 63 6f 6e 64 7e 0c 00 00 81 00 05 81 01 00 82 02 01 81
tick 200
# {CC-INFO}: <<MULTI-KEYPAD>> 1CH 35H, <<CALL-INFORMATION>> call id 2:
# accept the waiting call, holding the active one.
pp 03 7b 2c 02 1c 35 7e 03 01 00 82
ev hold call=1 hs=1
ev answered call=2 hs=1
ev audio call=2 path=build/stubd-test-run/audio.sock
fp 83 7b 7e 06 01 00 81 02 01 89
fp 83 7b 7e 06 01 00 82 02 01 85
tick 200
# Toggle back to call id 1 (31H).
pp 03 7b 2c 02 1c 31 7e 03 01 00 81
ev hold call=2 hs=1
ev resume call=1 hs=1
ev audio call=1 path=build/stubd-test-run/audio.sock
fp 83 7b 7e 06 01 00 82 02 01 89
fp 83 7b 7e 06 01 00 81 02 01 85
tick 200
# Release call id 2 (33H).
pp 03 7b 2c 02 1c 33 7e 03 01 00 82
ev released call=2 hs=1 by=hs
fp 83 7b 7e 06 01 00 82 02 01 80
tick 200
# DECT 1 hangs up.
pp 03 4d e2 00
ev released call=1 hs=1 by=hs
fp 83 5a
mail 0233 01 01
mail 0202 01
tick 500
down
tick 1000
