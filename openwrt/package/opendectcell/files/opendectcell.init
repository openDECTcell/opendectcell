#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
#
# openDECTcell: boot the DECT chip and run the base station daemon.
#
# Disabled by default (option enabled '0'): installing the package loads no
# module and puts nothing on the air. Stopping the service parks the radio:
# dect-stubd parks it on SIGTERM, and stop_service() sends the park mails
# again afterwards in case the daemon could not.

START=95
STOP=10
USE_PROCD=1
extra_command "register" "Open handset registration for 'regwindow' seconds (120)"
extra_command "forget" "Remove a deregistered handset's settings: forget <1-6>"

PROG=/usr/sbin/dect-stubd
PARK="-M 0x22:0x02:0x022c:01 -M 0x22:0x02:0x015b:00 -t 6"

log() { logger -t opendectcell "$*"; echo "opendectcell: $*" >&2; }

# Model-specific values live in a board profile, one file per
# /tmp/sysinfo/board_name (docs/hardware-abstraction.md); UCI overrides them.
# These are the 7520/7530 defaults, used if no profile is found.
: "${uart:=/dev/ttyMSM0}"
: "${dect_mode:=0x105}"
: "${fw_firstlevel:=dectfw_firstlevel_441_slow.hex}"
: "${fw_secondlevel:=dectfw_secondlevel_441-07.56.hex}"
: "${factory_mtd:=/dev/mtd5}"
: "${factory_offset:=0x3d000}"
: "${strap:=1}"
: "${led_path:=/sys/class/leds/green:fon/brightness}"

dect_load_profile() {
	local b
	b=$(cat /tmp/sysinfo/board_name 2>/dev/null)
	if [ -n "$b" ] && [ -r "/usr/share/opendectcell/boards/$b" ]; then
		. "/usr/share/opendectcell/boards/$b"
	else
		log "no board profile for '${b:-unknown}'; using the 7520 defaults"
	fi
	[ -n "${led_path:-}" ] || led_path=/sys/class/leds/green:fon/brightness
}
dect_load_profile

# A random 4-digit registration PIN, saved in the config (also made by the
# package's uci-defaults script at install).
# A random PIN of pin_length digits: 8 (the most GAP allows), 6 or 4.
pin_make() {
	local n
	config_get n main pin_length 8
	case "$n" in 4|6|8) ;; *) n=8 ;; esac
	tr -dc 0-9 < /dev/urandom | head -c "$n"
}

# The chip builds openDECTcell was tested with (docs/firmware-sourcing.md;
# tools/dect-fw-extract.py has the same table). Our protocol knowledge
# belongs to these, so anything else is refused unless allowed.
KNOWN_FW="
0d855b5929f8b2ad0b8d8fb38065b32e27f9357cd44a2b4e60573b1b5b6da895
9bdb332678f981d83ac31cf1b68c489ab9c979e2ac601d18b81bb802f16d0d20
7cac33c72b2222468f34033a15c35487aa35062265ab0013bb480068ebab7b31
72f8e27a0d01c301a05a8b373a71887af882a6cebcb1a30bd4a435580e1045f2
4fabee65d07a3214f9083de81ae54089f01bbfccb4cdbb672f37487a09cdfaa6
"

fw_known() {
	local sum
	sum=$(sha256sum "$1" 2>/dev/null) || return 1
	sum=${sum%% *}
	case "$KNOWN_FW" in *"$sum"*) return 0 ;; esac
	return 1
}

# The DECT UART is also the serial console on this box; a getty on it reads
# the chip's replies away, and kernel messages land in the upload. Freeze a
# running getty (until the next reboot: resuming it hangs up the UART; the
# package's uci-defaults script disables it for good) and quiet the kernel
# console -- what the lab's fwload.sh has done before every upload.
console_claim() {
	local uart="$1" p
	echo 1 > /proc/sys/kernel/printk
	for p in /proc/[0-9]*; do
		[ "$(cat "$p/comm" 2>/dev/null)" = askfirst ] || continue
		ls -l "$p/fd" 2>/dev/null | grep -q "${uart##*/}" || continue
		kill -STOP "${p#/proc/}" &&
			log "froze the console getty on $uart, the DECT UART"
	done
	return 0
}

load_chip() {
	local dir first second uart mtd off mode unverified f extra
	config_get dir main firmware_dir /etc/opendectcell/firmware
	config_get first main first "$fw_firstlevel"
	config_get second main second "$fw_secondlevel"
	config_get uart main uart "$uart"
	config_get mtd main factory_mtd "$factory_mtd"
	config_get off main factory_offset "$factory_offset"
	config_get mode main mode "$dect_mode"
	config_get strapv main strap "$strap"

	[ -r "$dir/$first" ] && [ -r "$dir/$second" ] || {
		log "chip firmware missing in $dir ($first, $second); not starting"
		return 1
	}
	config_get_bool unverified main fw_allow_unverified 0
	for f in "$dir/$first" "$dir/$second"; do
		fw_known "$f" && continue
		if [ "$unverified" = 1 ]; then
			log "WARNING: $f is not a firmware build opendectcell knows; running it anyway (fw_allow_unverified)"
		else
			log "$f is not a firmware build opendectcell knows; not starting. Extract it with tools/dect-fw-extract.py from the FRITZ!OS version in docs/firmware-sourcing.md"
			return 1
		fi
	done
	grep -q '^opendectcell ' /proc/modules || insmod opendectcell || {
		log "insmod opendectcell failed"
		return 1
	}
	# Already booted since the last module load: keep it.
	[ -s /tmp/dect-stub.second ] && return 0
	console_claim "$uart"
	extra=""
	[ -n "$mtd" ] && extra="$extra --factory-mtd $mtd --factory-offset $off"
	[ "$strapv" = 0 ] && extra="$extra --no-strap"
	# shellcheck disable=SC2086
	/usr/sbin/dect-fwload --uart "$uart" --dect-dev /dev/dect0 \
		--first "$dir/$first" --second "$dir/$second" --mode "$mode" \
		$extra \
		>/tmp/dect-fwload.log 2>&1 || {
		log "chip firmware upload failed, see /tmp/dect-fwload.log"
		rm -f /tmp/dect-stub.second
		return 1
	}
	# dect-stubd reads this to know which build's RAM addresses apply.
	echo "$second" > /tmp/dect-stub.second
}

# A handset's own settings (Network > DECT, Handsets, General): each
# 'list override key=value' of its 'config handset' section becomes a line
# of /etc/opendectcell/handset<slot>.override, which dect-stubd lays over the
# handset's profile. Written afresh at every start.
OVERRIDE_DIR=/etc/opendectcell

override_line() {
	local kv="$1" slot="$2" k v
	k=${kv%%=*}
	v=${kv#*=}
	# a key and a value as the profile format has them, nothing else
	case "$k" in *[!a-z0-9._]*|"") return ;; esac
	case "$v" in *[!A-Za-z0-9x:{}_\ -]*|"") return ;; esac
	printf '%s = %s\n' "$k" "$v" >> "$OVERRIDE_DIR/handset$slot.override"
}

override_write() {
	local slot
	config_get slot "$1" slot
	case "$slot" in [1-6]) ;; *) return ;; esac
	config_list_foreach "$1" override override_line "$slot"
}

overrides_write() {
	mkdir -p "$OVERRIDE_DIR"
	rm -f "$OVERRIDE_DIR"/handset*.override "$OVERRIDE_DIR"/handset*.lines
	config_foreach override_write handset
	lines_resolve
	config_foreach lines_write handset
}

# A handset's Line 1 and Line 2 are VoIP profiles ('config voip' sections,
# Network > DECT, VoIP Profiles), named by its options line1 and line2.
# Resolved once per start into LINE_<slot>_<n>: a profile serves one line
# only, so a second assignment is refused here as well as in LuCI.
lines_resolve_one() {
	local sec="$1" slot n p t
	config_get slot "$sec" slot
	case "$slot" in [1-6]) ;; *) return ;; esac
	for n in 1 2; do
		config_get p "$sec" line$n
		[ -n "$p" ] || continue
		config_get t "$p" TYPE
		if [ "$t" != voip ]; then
			log "DECT $slot line $n: there is no VoIP profile '$p'; line left out"
			continue
		fi
		case "$LINES_USED" in
		*" $p "*)
			log "DECT $slot line $n: VoIP profile '$p' already serves another line; left out"
			continue
			;;
		esac
		LINES_USED="$LINES_USED$p "
		eval "LINE_${slot}_$n=\$p"
	done
}

lines_resolve() {
	local s
	LINES_USED=" "
	for s in 1 2 3 4 5 6; do
		eval "LINE_${s}_1= LINE_${s}_2="
	done
	config_foreach lines_resolve_one handset
}

# A handset's line names: "<line> <name>" in /etc/opendectcell/handset<slot>.lines,
# from each assigned profile's line_name, else its name if that fits the
# list's 15 octets; Line 1 always, Line 2 only with a profile. The handset's
# Line Settings List shows them.
line_name() {
	printf '%s' "$1" | tr -d '\000-\037'
}

lines_write() {
	local slot n p v f
	config_get slot "$1" slot
	case "$slot" in [1-6]) ;; *) return ;; esac
	f="$OVERRIDE_DIR/handset$slot.lines"
	: > "$f"
	for n in 1 2; do
		eval "p=\$LINE_${slot}_$n"
		if [ -z "$p" ]; then
			[ "$n" = 1 ] && printf '1 Line 1\n' >> "$f"
			continue
		fi
		config_get v "$p" line_name
		if [ -z "$v" ]; then
			config_get v "$p" name
			[ ${#v} -le 15 ] || v="Line $n"
		fi
		printf '%s %s\n' "$n" "$(line_name "$v")" >> "$f"
	done
	return 0
}

# The SIP side (Network > DECT, VoIP Profiles, assigned under Handsets):
# baresip with the openDECTcell module as the bridge (docs/bridge-interface.md),
# its config and accounts written here from /etc/config/opendectcell, and the
# line map /var/run/opendectcell/lines ("<hs> <line> <aor>") the module reads.
BARESIP=/usr/bin/baresip
BS_DIR=/var/run/opendectcell/baresip
BS_MODS=/usr/lib/baresip/modules
BS_ACCOUNTS=0

# a value for an account parameter: no ; " < > or whitespace
bs_safe() {
	case "$1" in *[\;\"\<\>\ \	]*) return 1 ;; esac
	return 0
}

bs_line() {
	local slot="$1" n="$2" sec v user dom aor line codecs c auto
	eval "sec=\$LINE_${slot}_$n"
	[ -n "$sec" ] || return 0
	config_get user "$sec" user
	config_get dom "$sec" domain
	[ -n "$user" ] && [ -n "$dom" ] && bs_safe "$user" && bs_safe "$dom" || {
		log "DECT $slot line $n: profile '$sec' has no usable user name or registrar; line left out"
		return 0
	}
	aor="sip:$user@$dom"
	# two profiles with the same account would be one baresip account
	case "$BS_AORS" in
	*" $aor "*)
		log "DECT $slot line $n: profile '$sec' has the account $aor of another line; left out"
		return 0
		;;
	esac
	BS_AORS="$BS_AORS$aor "
	config_get v "$sec" transport udp
	line="<$aor"
	[ "$v" = udp ] || line="$line;transport=$v"
	line="$line>"
	config_get v "$sec" display
	v=$(printf '%s' "$v" | tr -d '"<>\\')
	[ -n "$v" ] && line="\"$v\" $line"
	config_get v "$sec" authuser
	[ -n "$v" ] && bs_safe "$v" && line="$line;auth_user=$v"
	config_get v "$sec" password
	if [ -n "$v" ]; then
		bs_safe "$v" && line="$line;auth_pass=$v" ||
			log "DECT $slot line $n: the password has a character baresip cannot take (; \" < > or a space)"
	fi
	config_get v "$sec" outbound
	[ -n "$v" ] && bs_safe "$v" && line="$line;outbound=\"sip:$v\""
	config_get v "$sec" outbound2
	[ -n "$v" ] && bs_safe "$v" && line="$line;outbound2=\"sip:$v\""
	config_get_bool v "$sec" register 1
	if [ "$v" = 1 ]; then
		config_get v "$sec" regint 3600
		line="$line;regint=$v"
	else
		line="$line;regint=0"
	fi
	config_get_bool v "$sec" sipnat 0
	[ "$v" = 1 ] && line="$line;sipnat=outbound"
	config_get v "$sec" medianat
	case "$v" in
	stun|turn|ice)
		line="$line;medianat=$v"
		config_get c "$sec" stunserver
		[ -n "$c" ] && bs_safe "$c" && line="$line;stunserver=\"$([ "$v" = turn ] && echo turn || echo stun):$c\""
		config_get c "$sec" stunuser
		[ -n "$c" ] && bs_safe "$c" && line="$line;stunuser=$c"
		config_get c "$sec" stunpass
		[ -n "$c" ] && bs_safe "$c" && line="$line;stunpass=$c"
		;;
	esac
	config_get v "$sec" rtpkeep
	case "$v" in zero|stun|dyna|rtcp) line="$line;rtpkeep=$v" ;; esac
	# Media "try to autodetect" (the default): every codec offered, HD
	# first, and key tones as the other side's offer says
	config_get_bool auto "$sec" media_auto 1
	if [ "$auto" = 1 ]; then
		line="$line;audio_codecs=G722/16000/1,PCMA/8000/1,PCMU/8000/1;ptime=20;dtmfmode=auto;100rel=yes"
	else
		config_get v "$sec" codec 'g722 pcma pcmu'
		codecs=""
		for c in $v; do
			case "$c" in g722) c=G722/16000/1 ;; pcma) c=PCMA/8000/1 ;; pcmu) c=PCMU/8000/1 ;; *) continue ;; esac
			codecs="${codecs:+$codecs,}$c"
		done
		[ -n "$codecs" ] && line="$line;audio_codecs=$codecs"
		config_get v "$sec" ptime 20
		case "$v" in 10|20|30|40) line="$line;ptime=$v" ;; esac
		config_get v "$sec" dtmf rtpevent
		case "$v" in rtpevent|info|auto) line="$line;dtmfmode=$v" ;; esac
		config_get v "$sec" rel100 yes
		case "$v" in yes|no|required) line="$line;100rel=$v" ;; esac
	fi
	config_get_bool v "$sec" mwi 0
	line="$line;mwi=$([ "$v" = 1 ] && echo yes || echo no)"
	config_get_bool v "$sec" transfer 1
	line="$line;call_transfer=$([ "$v" = 1 ] && echo yes || echo no)"
	# Encryption "try to autodetect" (the default): SRTP offered, plain
	# RTP when the other side does not take it
	config_get_bool auto "$sec" enc_auto 1
	if [ "$auto" = 1 ]; then
		if [ -f "$BS_MODS/srtp.so" ]; then
			line="$line;mediaenc=srtp"
		else
			log "DECT $slot line $n: baresip-mod-srtp is not installed; speech goes unencrypted"
		fi
	else
		config_get v "$sec" mediaenc
		case "$v" in srtp|srtp-mand|srtp-mandf|dtls_srtp|zrtp) line="$line;mediaenc=$v" ;; esac
	fi
	line="$line;answermode=manual"
	config_get v "$sec" extra
	case "$v" in ";"*) line="$line$v" ;; esac
	printf '%s\n' "$line" >> "$BS_DIR/accounts"
	printf '%s %s %s\n' "$slot" "$n" "$aor" >> /var/run/opendectcell/lines
	BS_ACCOUNTS=$((BS_ACCOUNTS + 1))
}

bs_handset() {
	local slot
	config_get slot "$1" slot
	case "$slot" in [1-6]) ;; *) return ;; esac
	bs_line "$slot" 1
	bs_line "$slot" 2
}

bs_module() {
	[ -f "$BS_MODS/$2" ] && printf '%s %s\n' "$1" "$2" >> "$BS_DIR/config"
	return 0
}

# Write baresip's files; 0 when at least one line is on.
baresip_write() {
	local v lo hi
	BS_ACCOUNTS=0
	[ -x "$BARESIP" ] && [ -f "$BS_MODS/opendectcell.so" ] || return 1
	mkdir -p "$BS_DIR"
	chmod 700 /var/run/opendectcell "$BS_DIR"
	: > "$BS_DIR/accounts"
	chmod 600 "$BS_DIR/accounts"
	: > /var/run/opendectcell/lines
	[ -n "$LINES_USED" ] || lines_resolve
	BS_AORS=" "
	config_foreach bs_handset handset
	[ "$BS_ACCOUNTS" -gt 0 ] || return 1
	{
		echo "# written by /etc/init.d/opendectcell from /etc/config/opendectcell"
		config_get v main sip_port 5060
		echo "sip_listen 0.0.0.0:$v"
		config_get v main rtp_ports '10000-20000'
		echo "rtp_ports $v"
		config_get v main rtp_dscp 46
		echo "rtp_tos $((v * 4))"
		config_get v main sip_dscp 24
		echo "sip_tos $((v * 4))"
		config_get v main net_interface
		[ -n "$v" ] && echo "net_interface $v"
		config_get v main dns_server
		# baresip wants IP:port; a bare address gets port 53
		case "$v" in
		"") ;;
		*.*.*.*:*|\[*\]:*) echo "dns_server $v" ;;
		*:*) echo "dns_server [$v]:53" ;;
		*) echo "dns_server $v:53" ;;
		esac
		config_get_bool v main tls_verify 1
		echo "sip_verify_server $([ "$v" = 1 ] && echo yes || echo no)"
		config_get v main tls_cafile
		[ -n "$v" ] && echo "sip_cafile $v"
		config_get v main jitter '20-160'
		lo=${v%-*}; hi=${v#*-}
		echo "audio_jitter_buffer_type adaptive"
		echo "audio_jitter_buffer_delay $(( (lo + 19) / 20 ))-$(( (hi + 19) / 20 ))"
		echo "audio_player opendectcell,"
		echo "audio_source opendectcell,"
		echo "ausrc_srate 16000"
		echo "auplay_srate 16000"
		echo "ausrc_channels 1"
		echo "auplay_channels 1"
		echo "module_path $BS_MODS"
	} > "$BS_DIR/config"
	for v in g711.so g722.so stun.so turn.so ice.so srtp.so dtls_srtp.so mwi.so; do
		bs_module module "$v"
	done
	bs_module module_app account.so
	bs_module module_app opendectcell.so
	return 0
}

start_service() {
	local enabled pin stores options reg wb ov dw ci nocipher="" rw n spare f args=""
	local la tc
	config_load opendectcell
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	load_chip || return 1
	overrides_write
	config_get pin main pin ''
	if [ -z "$pin" ]; then
		pin=$(pin_make)
		uci -q set opendectcell.main.pin="$pin" && uci -q commit opendectcell
		log "made a registration PIN (Network > DECT, Handsets shows it)"
	fi
	config_get stores main stores '/etc/opendectcell-sub.*'
	config_get options main options ''
	config_get_bool reg main registration 0
	[ "$reg" = 1 ] && options="${options:+$options,}regopen"
	config_get_bool wb main wideband 1
	[ "$wb" = 1 ] || options="${options:+$options,}narrowband"
	config_get_bool ov main overlap 1
	config_get dw main dialwait 3000
	if [ "$ov" = 1 ]; then
		options="${options:+$options,}dialwait=$dw"
	else
		options="${options:+$options,}nooverlap"
	fi
	# On unless turned off: ciphered calls work since 2026-10-28
	config_get_bool ci main cipher 1
	[ "$ci" = 1 ] || nocipher="-C"
	config_get rw main regwindow 120
	options="${options:+$options,}regwindow=$rw"
	# authentication on location registration: the daemon's default
	config_get_bool la main locauth 1
	[ "$la" = 1 ] || options="${options:+$options,}nolocauth"
	config_get_bool tc main twocalls 0
	[ "$tc" = 1 ] && options="${options:+$options,}twocalls"
	# The DECT LED path is a board-profile detail (e.g. green:fon on the
	# 7520, green:dect on the 7412). The user can turn the LED off with
	# 'noled' or point it elsewhere with 'led=PATH' in options.
	if [ -n "${led_path:-}" ]; then
		case ",$options," in
		*,led=*|*,noled,*) ;;
		*) options="${options:+$options,}led=$led_path" ;;
		esac
	fi
	# the stores only: not their side files (.name, .profile,
	# .deregistered, ...), which share the pattern
	for f in $stores; do
		case "${f#"${stores%%\**}"}" in *.*) continue ;; esac
		[ -s "$f" ] && args="$args -s $f"
	done
	# and two stores that do not exist yet: where `register` puts new
	# handsets (a known one re-enrols into its own)
	spare=0
	for n in 1 2 3 4 5 6; do
		f="${stores%%\**}$n"
		[ -s "$f" ] && continue
		args="$args -s $f"
		spare=$((spare + 1))
		[ $spare -ge 2 ] && break
	done

	procd_open_instance
	procd_set_param command $PROG -g -P "$pin" $nocipher $args \
		${options:+-a "$options"}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	# a crash restarts it; five quick failures in a row give up
	procd_set_param respawn 3600 5 5
	procd_close_instance

	# the SIP side, when a handset has a line
	if baresip_write; then
		procd_open_instance baresip
		procd_set_param command "$BARESIP" -f "$BS_DIR"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param respawn 3600 5 5
		procd_close_instance
		log "SIP: $BS_ACCOUNTS line(s), baresip with the opendectcell bridge"
	fi
}

# Save & Apply in LuCI (Network > DECT) restarts the base with the new
# settings; a call in progress ends.
service_triggers() {
	procd_add_reload_trigger "opendectcell"
}

# After a deregistration (LuCI, Handsets): the handset's section goes from
# /etc/config/opendectcell, committed on its own, so changes the user saved but
# has not applied stay pending and are not applied with it. Its VoIP
# profiles stay, free; baresip restarts only if it had a line.
forget() {
	local slot="$1" l1 l2
	case "$slot" in
	[1-6]) ;;
	*) echo "usage: $0 forget <1-6>" >&2; return 1 ;;
	esac
	[ -n "$(uci -q get "opendectcell.dect$slot")" ] || return 0
	l1=$(uci -q get "opendectcell.dect$slot.line1")
	l2=$(uci -q get "opendectcell.dect$slot.line2")
	uci -q delete "opendectcell.dect$slot" && uci -q commit opendectcell || return 1
	rm -f "$OVERRIDE_DIR/handset$slot.override" "$OVERRIDE_DIR/handset$slot.lines"
	log "DECT $slot's settings removed"
	if [ -n "$l1$l2" ] && pidof dect-stubd >/dev/null; then
		log "DECT $slot had a line: restarting for the SIP side"
		/etc/init.d/opendectcell restart
	fi
	return 0
}

# Open the registration window on the running daemon: 'regwindow' seconds,
# closed again after one handset enrols. The command-line way; LuCI uses
# the control socket (register-window).
register() {
	local pid
	pid=$(pidof dect-stubd) || { log "not running"; return 1; }
	kill -USR1 $pid && log "registration open"
}

stop_service() {
	# procd has sent SIGTERM and dect-stubd parked on the way out; make
	# sure, since a radio left on transmits by itself.
	sleep 1
	pgrep -x dect-stubd >/dev/null || $PROG $PARK >/dev/null 2>&1
}
